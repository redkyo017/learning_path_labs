# =============================================================================
# learning_path_labs — hands-on lab work across all learning paths.
#
# Rule of thumb: commit the code you wrote and the config that makes a lab
# reproducible. Never commit credentials, state, or anything a tool regenerates.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets and credentials — the ones that actually cost money if leaked
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
credentials
.aws/
.netrc
*_rsa
*_ed25519
*_ecdsa
*.ppk
authorized_keys

# Private key material. Public certs (*.cert.pem, *.crt, *.cer, *.csr) stay
# tracked — the certificate labs need them for verification exercises.
*.key
*.key.pem
*.pem.key
*.p12
*.pfx
*.jks
*.keystore
*.truststore
privkey*
*private*.pem

# AWS / cloud CLI leftovers
.aws-sam/
samconfig.toml
cdk.out/
.serverless/
kubeconfig
kubeconfig.*
.kube/

# -----------------------------------------------------------------------------
# Terraform
# -----------------------------------------------------------------------------
# Provider plugins: ~900 MB per working dir for the AWS provider. Never commit.
**/.terraform/*
.terraform/
.terraform.tfstate.lock.info

# State contains resource IDs, IPs, and sometimes secrets in plaintext.
*.tfstate
*.tfstate.*
terraform.tfstate.d/

# Plan files are binary and can embed credentials.
*.tfplan
tfplan
tfplan.*
plan.out

# Local overrides and crash dumps
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log
.terraformrc
terraform.rc

# tfvars: terraform.tfvars IS tracked (region, CIDRs, profile name — lab config
# that makes the labs reproducible). Only auto-loaded and secret ones are out.
*.auto.tfvars
*.auto.tfvars.json
*secret*.tfvars
*secrets*.tfvars

# .terraform.lock.hcl is intentionally NOT ignored — commit it so provider
# versions and per-platform hashes stay pinned across machines.

# -----------------------------------------------------------------------------
# Go (algorithms/labs-go, golang_mastery, aws_devops_sre/app)
# -----------------------------------------------------------------------------
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html
vendor/
go.work.sum

# -----------------------------------------------------------------------------
# Python (physics, linear_algebra, quantum, scripting)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
# Node / JavaScript
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnp.*
.next/
.nuxt/

# -----------------------------------------------------------------------------
# Java / Maven / Gradle (wso2_mastery)
# -----------------------------------------------------------------------------
target/
*.class
.gradle/
build/
!src/**/build/
*.war
*.ear
hs_err_pid*
replay_pid*

# -----------------------------------------------------------------------------
# Containers, Kafka, local service data
# -----------------------------------------------------------------------------
docker-compose.override.yml
.docker/
data/
!data/.gitkeep
volumes/
kafka-logs/
zookeeper-data/
*.pid
*.sock

# -----------------------------------------------------------------------------
# Logs, scratch, and generated output
# -----------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
scratch/
out/
output/
*.tmp
*.bak
*.orig
*.rej
*~

# Large artifacts pulled down during labs (installers, provider zips, dumps)
*.zip
*.tar
*.tar.gz
*.tgz
*.iso
*.dmg
*.dump
*.sql.gz
!**/fixtures/**/*.zip

# -----------------------------------------------------------------------------
# macOS / editors / IDEs
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db

.vscode/
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.iml
*.swp
*.swo
*.sublime-workspace
.netrwhist
tags

# -----------------------------------------------------------------------------
# Personal notes — uncomment if you keep private scratch notes per lab
# -----------------------------------------------------------------------------
# journal.md
# NOTES.local.md
